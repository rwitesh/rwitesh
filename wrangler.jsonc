{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwiteshbera",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "rwitesh.com",
      "zone_name": "rwitesh.com",
      "custom_domain": true
    }
  ]
}

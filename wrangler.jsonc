{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwiteshbera",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "rwitesh.com",
      "zone_name": "rwitesh.com",
      "custom_domain": true
    }
  ]
}
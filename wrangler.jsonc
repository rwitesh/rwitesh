{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
  // To serve the site at rwitesh.com, add a custom-domain route below.
  // Requires the `rwitesh.com` zone to be active on this Cloudflare account,
  // then set "workers_dev": false so rwitesh.com is the sole origin.
  // "routes": [
  //   { "pattern": "rwitesh.com", "custom_domain": true },
  //   { "pattern": "www.rwitesh.com", "custom_domain": true }
  // ]
}

---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span class="views-container" data-slug={slug}>
  <svg class="views-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span class="views-count">...</span> views
</span>

<style>
.views-container {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
  font-size: var(--text-size-sm, 0.9rem);
  color: var(--text-faint, #888);
}

.views-icon {
  opacity: 0.7;
}

.views-count {
  font-weight: 500;
}
</style>

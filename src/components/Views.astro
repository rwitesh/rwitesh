---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span class="views-container" data-slug={slug}>
  <svg class="views-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span class="views-count">...</span> views
</span>

<script>
  function setupViews() {
    const containers = document.querySelectorAll<HTMLElement>('.views-container');

    containers.forEach(async (container) => {
      const slug = container.dataset.slug;
      if (!slug) return;

      const countEl = container.querySelector<HTMLElement>('.views-count');
      if (!countEl) return;

      try {
        const res = await fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug })
        });

        if (res.ok) {
          const data = (await res.json()) as { count?: number };
          countEl.textContent = String(data.count ?? 0);
        } else {
          countEl.textContent = '0';
        }
      } catch (err) {
        console.warn('Failed to load views count', err);
        countEl.textContent = '0';
      }
    });
  }

  setupViews();
</script>

<style>
.views-container {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
  font-size: var(--text-size-sm, 0.9rem);
  color: var(--text-faint, #888);
}

.views-icon {
  opacity: 0.7;
}

.views-count {
  font-weight: 500;
}
</style>

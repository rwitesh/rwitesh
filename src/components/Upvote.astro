---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="upvote-container" data-slug={slug}>
  <button type="button" class="upvote-btn" aria-label="Upvote this post">
    <svg class="upvote-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
    </svg>
    <span class="upvote-text">Upvote</span>
    <span class="upvote-count">...</span>
  </button>
</div>

<script>
  function setupUpvotes() {
    const containers = document.querySelectorAll<HTMLElement>('.upvote-container');

    containers.forEach(async (container) => {
      const slug = container.dataset.slug;
      if (!slug) return;

      const btn = container.querySelector<HTMLButtonElement>('.upvote-btn');
      const countEl = container.querySelector<HTMLElement>('.upvote-count');
      const textEl = container.querySelector<HTMLElement>('.upvote-text');
      if (!btn || !countEl || !textEl) return;

      const storageKey = `voted:${slug}`;
      let localVoted = localStorage.getItem(storageKey) === 'true';

      if (localVoted) {
        btn.classList.add('voted');
        textEl.textContent = 'Upvoted';
      }

      // 1. Fetch count & server vote status
      try {
        const res = await fetch(`/api/upvote?slug=${encodeURIComponent(slug)}`);
        if (res.ok) {
          const data = (await res.json()) as { count?: number; hasVoted?: boolean };
          countEl.textContent = String(data.count ?? 0);
          if (data.hasVoted) {
            localStorage.setItem(storageKey, 'true');
            btn.classList.add('voted');
            textEl.textContent = 'Upvoted';
          }
        } else {
          countEl.textContent = '0';
        }
      } catch (err) {
        console.warn('Failed to load upvote count', err);
        countEl.textContent = '0';
      }

      // 2. Handle Upvote click
      btn.addEventListener('click', async () => {
        if (btn.classList.contains('voted') || btn.disabled) return;

        btn.disabled = true;
        const currentCount = parseInt(countEl.textContent || '0', 10);
        
        // Optimistic UI update
        countEl.textContent = String(currentCount + 1);
        btn.classList.add('voted');
        textEl.textContent = 'Upvoted';

        try {
          const res = await fetch('/api/upvote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug })
          });

          const data = (await res.json()) as { count?: number; hasVoted?: boolean; success?: boolean };

          if (res.ok && data.success) {
            localStorage.setItem(storageKey, 'true');
            countEl.textContent = String(data.count);
          } else if (res.status === 409 || data.hasVoted) {
            // Already voted on server
            localStorage.setItem(storageKey, 'true');
            countEl.textContent = String(data.count ?? currentCount);
          } else {
            // Rollback optimistic update on error
            countEl.textContent = String(currentCount);
            btn.classList.remove('voted');
            textEl.textContent = 'Upvote';
            btn.disabled = false;
          }
        } catch (err) {
          console.error('Error sending upvote:', err);
          countEl.textContent = String(currentCount);
          btn.classList.remove('voted');
          textEl.textContent = 'Upvote';
          btn.disabled = false;
        }
      });
    });
  }

  // Run on initial page load
  setupUpvotes();
</script>

<style>
.upvote-container {
  margin: var(--space-md) 0;
}

.upvote-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  background: transparent;
  border: 1px solid var(--border, #ccc);
  border-radius: 4px;
  padding: 0.4rem 0.8rem;
  font-family: inherit;
  font-size: var(--text-size-sm, 0.9rem);
  color: var(--text, inherit);
  cursor: pointer;
  transition: all 0.15s ease;
}

.upvote-btn:hover:not(:disabled):not(.voted) {
  border-color: var(--link, #0066cc);
  color: var(--link, #0066cc);
}

.upvote-btn.voted {
  background: var(--tag-bg, rgba(0, 102, 204, 0.1));
  border-color: var(--link, #0066cc);
  color: var(--link, #0066cc);
  cursor: default;
}

.upvote-btn:disabled {
  opacity: 0.7;
}

.upvote-icon {
  transition: transform 0.15s ease;
}

.upvote-btn:hover:not(.voted) .upvote-icon {
  transform: translateY(-2px);
}

.upvote-count {
  font-weight: 600;
  margin-left: 0.2rem;
}
</style>

---
import { SITE } from '../config/site.ts';
import LocationTime from './LocationTime.astro';
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="footer-rss" href="/rss.xml">subscribe to rss feed</a>
    <p class="footer-bottom">
      <LocationTime />
      <span class="separator" aria-hidden="true">·</span>
      <span>{SITE.footer.text}</span>
    </p>
  </div>
</footer>

<style>
.site-footer {
  width: 100%;
  max-width: var(--max-width);
  margin: var(--space-xl) auto 0;
  padding: 0 var(--content-padding) var(--space-sm);
  justify-self: center;
}

.footer-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.35rem;
  text-align: center;
}

.footer-rss {
  font-size: var(--text-size-sm);
  color: var(--text-soft);
  white-space: nowrap;
  border-bottom: none;
}

.footer-rss:hover {
  color: var(--link);
  border-bottom: none;
}

.footer-bottom {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  white-space: nowrap;
  font-size: var(--text-size-sm);
  color: var(--text-faint);
}

.separator {
  color: var(--text-faint);
}
</style>

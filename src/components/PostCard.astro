---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { post, compact = false, headingLevel = 'h2' } = Astro.props;
const { title, pubDate, tags } = post.data;
const Heading = headingLevel;
const showTags = !compact && tags && tags.length > 0;
---

<article class="post-entry" class:list={[{ compact }]}>
  <a href={`/posts/${post.id}/`} class="post-link">
    {compact ? (
      <div class="post-row">
        <span class="post-date"><FormattedDate date={pubDate} /></span>
        <Heading class="post-title">{title}</Heading>
      </div>
    ) : (
      <>
        <Heading class="post-title">{title}</Heading>
        <div class="post-meta">
          <span class="post-date"><FormattedDate date={pubDate} /></span>
          {showTags && tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      </>
    )}
  </a>
</article>

<style>
.post-entry {
  border-bottom: 1px solid var(--border-soft);
}

.post-entry:last-child {
  border-bottom: none;
}

.post-link {
  display: block;
  padding: 0.45rem 0;
  color: inherit;
  border-bottom: none;
}

.post-link:hover {
  border-bottom: none;
}

.post-title {
  display: block;
  font-size: var(--text-size);
  font-weight: 500;
  margin: 0;
  letter-spacing: -0.01em;
  line-height: 1.4;
  transition: color 0.12s ease;
}

.post-link:hover .post-title {
  color: var(--link);
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 0.55rem;
  row-gap: 0.1rem;
  margin-top: 0.1rem;
  line-height: 1.35;
}

.post-date {
  font-size: var(--text-size-sm);
  color: var(--text-faint);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.tag {
  font-size: var(--text-size-sm);
  color: var(--text-faint);
}

/* Home recent list: date + title on one row */
.post-row {
  display: flex;
  align-items: baseline;
  gap: 0.85rem;
  min-width: 0;
}

.post-entry.compact .post-link {
  padding: 0.3rem 0;
}

.post-entry.compact .post-date {
  flex-shrink: 0;
  width: 6.75rem;
}

.post-entry.compact .post-title {
  min-width: 0;
}

@media (max-width: 30rem) {
  .post-link {
    padding: 0.5rem 0;
  }

  .post-entry.compact .post-row {
    flex-direction: column;
    gap: 0.1rem;
  }

  .post-entry.compact .post-date {
    width: auto;
  }
}
</style>
